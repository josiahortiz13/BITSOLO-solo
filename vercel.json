{
  "version": 2,
  "builds": [
    {
      "src": "api/checkout.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/stripe-webhook.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/raffle-stats.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/signup.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "raffle.html",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.svg",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/checkout",
      "dest": "/api/checkout.js"
    },
    {
      "src": "/api/stripe-webhook",
      "dest": "/api/stripe-webhook.js"
    },
    {
      "src": "/api/raffle-stats",
      "dest": "/api/raffle-stats.js"
    },
    {
      "src": "/api/signup",
      "dest": "/api/signup.js"
    },
    {
      "src": "/favicon.svg",
      "dest": "/favicon.svg"
    },
    {
      "src": "/raffle",
      "dest": "/raffle.html"
    },
    {
      "src": "/raffle.html",
      "dest": "/raffle.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}

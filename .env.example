# Stripe — get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Vercel KV (Redis) — auto-provided by Vercel when you link a KV store,
# or copy from Vercel Dashboard → Storage → your KV store → .env.local
KV_URL=redis://...
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...
KV_REST_API_READ_ONLY_TOKEN=...
REDIS_URL=redis://...

# Raffle settings
RAFFLE_ACTIVE=true
RAFFLE_END_DATE=2026-04-22T23:59:59-05:00
